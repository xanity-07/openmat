# ============================================================
# Environment
# ============================================================

OPENMAT_PRIMARY__ENV=development


# ============================================================
# Server
# ============================================================

OPENMAT_SERVER__PORT=8080
OPENMAT_SERVER__READ_TIMEOUT=30
OPENMAT_SERVER__WRITE_TIMEOUT=30
OPENMAT_SERVER__IDLE_TIMEOUT=60
OPENMAT_SERVER__CORS_ALLOWED_ORIGINS=http://localhost:3001


# ============================================================
# Database
# ============================================================

OPENMAT_DATABASE__HOST=postgres
OPENMAT_DATABASE__PORT=5432
OPENMAT_DATABASE__USER=
OPENMAT_DATABASE__PASSWORD=
OPENMAT_DATABASE__NAME=
OPENMAT_DATABASE__SSL_MODE=disable
OPENMAT_DATABASE__MAX_OPEN_CONN=25
OPENMAT_DATABASE__MAX_IDLE_CONN=25
OPENMAT_DATABASE__CONN_MAX_LIFETIME=300
OPENMAT_DATABASE__CONN_MAX_IDLE_TIME=300


# ============================================================
# Authentication
# ============================================================

OPENMAT_AUTH__SECRET_KEY="your-development-secret"
OPENMAT_AUTH__TTL_HOURS=6


# ============================================================
# Tern
# ============================================================

TERN_DSN="host=postgres port=5432 dbname= user= password="


# ============================================================
# Redis
# ============================================================

OPENMAT_REDIS__ADDRESS=redis://redis:6379


# ============================================================
# Observability
# ============================================================

OPENMAT_OBSERVABILITY__SERVICE_NAME=openmat
OPENMAT_OBSERVABILITY__ENVIRONMENT=development


# ============================================================
# Logging
# ============================================================

OPENMAT_OBSERVABILITY__LOGGING__LEVEL=info
OPENMAT_OBSERVABILITY__LOGGING__FORMAT=json


# ============================================================
# New Relic
# ============================================================

OPENMAT_OBSERVABILITY__NEW_RELIC__LICENSE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENMAT_OBSERVABILITY__NEW_RELIC__APP_LOGS_FORWARDING_ENABLED=true
OPENMAT_OBSERVABILITY__NEW_RELIC__DISTRIBUTED_TRACING_ENABLED=true
OPENMAT_OBSERVABILITY__NEW_RELIC__DEBUG_LOGGER=false


# ============================================================
# Health Checks
# ============================================================

OPENMAT_OBSERVABILITY__HEALTH_CHECKS__CHECKS=database,redis
OPENMAT_OBSERVABILITY__HEALTH_CHECKS__ENABLED=true
OPENMAT_OBSERVABILITY__HEALTH_CHECKS__INTERVAL=30s
OPENMAT_OBSERVABILITY__HEALTH_CHECKS__TIMEOUT=5s
